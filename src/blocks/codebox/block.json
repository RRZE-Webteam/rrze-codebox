{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "rrze/codebox",
  "version": "1.0.0",
  "title": "CodeBox",
  "category": "rrze",
  "icon": "editor-code",
  "description": "Add syntax-highlighted code to your page",
  "keywords": [
    "code",
    "syntax",
    "highlight",
    "programming"
  ],
  "textdomain": "rrze-codebox",
  "attributes": {
    "content": {
      "type": "string",
      "default": ""
    },
    "language": {
      "type": "string",
      "default": "javascript"
    },
    "theme": {
      "type": "string",
      "default": "light",
      "enum": [
        "light",
        "dark"
      ]
    },
    "showLineNumbers": {
      "type": "boolean",
      "default": false
    },
    "firstLineNumber": {
      "type": "integer",
      "default": 1
    },
    "showLanguage": {
      "type": "boolean",
      "default": true
    },
    "syntaxHighlighting": {
      "type": "boolean",
      "default": true
    },
    "caption": {
      "type": "string",
      "default": ""
    },
    "captionUrl": {
      "type": "string",
      "default": ""
    },
    "contentEncoding": {
      "type": "string",
      "default": "raw",
      "enum": ["raw","base64"]
    }
  },
  "supports": {
    "html": false,
    "color": false,
    "typography": false,
    "spacing": false,
    "align": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php",
  "viewScript": "file:./view.js"
}


